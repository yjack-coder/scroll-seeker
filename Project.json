{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Project",
  "options": {
    "deploymentTarget": { "iOS": "26.0" },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Liubai": {
      "dependencies": [
        { "package": "RevenueCat", "product": "RevenueCat" },
        { "package": "RevenueCat", "product": "RevenueCatUI" }
      ],
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "留白 Liubai",
          "CFBundleURLTypes": [{ "CFBundleURLName": "Liubai", "CFBundleURLSchemes": ["liubai"] }],
          "NSMicrophoneUsageDescription": "Liubai uses the microphone to turn your spoken reflections into journal words on this device.",
          "NSSpeechRecognitionUsageDescription": "Liubai transcribes your spoken reflections on this device so you can paint without typing.",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.a30baecf-45e9-4613-abb3-bf5b54788ff5",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    }
  },
  "packages": {
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios",
      "exactVersion": "5.80.0"
    }
  }
}
